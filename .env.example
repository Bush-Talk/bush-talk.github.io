# HubSpot form submission. Both values are safe in the browser — the v3 forms
# endpoint takes no credentials, which is what keeps this site fully static.
#
# Portal ID:  HubSpot → Settings → Account Setup → Account Defaults
# Form GUID:  the last path segment of the form's edit URL
PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_HUBSPOT_FORM_GUID=
