---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch about a school program, workshop or individual session."
>
  <section class="section">
    <div class="shell contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Let's find the right fit</h1>
        <p class="lede">
          Tell us who you work with and what you are hoping for. There is no set package —
          programs are shaped around the group.
        </p>
        <EnquiryForm />
      </div>

      <aside class="details">
        <h2>Direct</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        </ul>

        <h2>Hours</h2>
        <p>{site.hours}</p>

        <h2>Where we work</h2>
        <ul>
          {site.locations.map((place) => <li>{place}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 54rem) {
    .contact { grid-template-columns: 1fr; }
  }

  .details {
    padding: 1.75rem;
    background: var(--paper-warm);
    border-radius: var(--radius-lg);
  }

  .details h2 {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
    margin: 0 0 0.6rem;
  }
  .details h2 + * { margin-bottom: 1.75rem; }
  .details ul { list-style: none; margin: 0 0 1.75rem; padding: 0; font-size: 0.9375rem; }
  .details li + li { margin-top: 0.4rem; }
  .details p { font-size: 0.9375rem; margin: 0 0 1.75rem; }
  .details > :last-child { margin-bottom: 0; }
</style>
