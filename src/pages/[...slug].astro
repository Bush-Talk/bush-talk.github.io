---
import type { GetStaticPaths } from 'astro';
import ContactCta from '../components/ContactCta.astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SmartImage from '../components/SmartImage.astro';

/**
 * Catch-all for free-form pages managed in the CMS (About, Policies, and so on).
 * Anything added to src/content/pages/ gets a URL from its filename.
 */
export const getStaticPaths = (async () => {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description} image={page.data.image}>
  <section class="section">
    <div class="shell shell--narrow">
      <h1>{page.data.title}</h1>
      {page.data.description && <p class="lede">{page.data.description}</p>}
      {page.data.image && (
        <SmartImage
          class="page-image"
          src={page.data.image}
          alt={page.data.imageAlt ?? ''}
          widths={[480, 760, 1040]}
          sizes="(max-width: 48rem) 100vw, 760px"
          loading="eager"
        />
      )}
      <div class="prose page-body">
        <Content />
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .page-body { margin-top: 2.5rem; }

  :global(.page-image) {
    width: 100%;
    margin-top: 2.5rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
</style>
