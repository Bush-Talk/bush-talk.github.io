---
import { getCollection } from 'astro:content';
import ContactCta from '../components/ContactCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Quote from '../components/shared/Quote';

const groups = [
  { key: 'principals', heading: 'From the principals' },
  { key: 'teachers', heading: 'From the teachers' },
  { key: 'kids', heading: 'From the kids' },
  { key: 'participants', heading: 'From participants' },
] as const;

const all = (await getCollection('testimonials', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const sections = groups
  .map((group) => ({ ...group, items: all.filter((t) => t.data.category === group.key) }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Reviews"
  description="What principals, teachers and kids say about Bush Talk programs."
>
  <section class="section">
    <div class="shell">
      <p class="eyebrow">Reviews</p>
      <h1>What people say</h1>

      {sections.map((group) => (
        <section class="group">
          <h2>{group.heading}</h2>
          <div class="quotes">
            {group.items.map(({ data }) => (
              <Quote quote={data.quote} author={data.author} role={data.role} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .group { margin-top: clamp(3rem, 6vw, 4.5rem); }

  .group h2 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clay);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    margin-top: 2rem;
  }
</style>
