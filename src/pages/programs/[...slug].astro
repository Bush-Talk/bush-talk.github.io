---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const programs = await getCollection('programs', ({ data }) => !data.draft);
  return programs.map((program) => ({
    params: { slug: program.id },
    props: { program },
  }));
}) satisfies GetStaticPaths;

const { program } = Astro.props;
const { Content } = await render(program);
const { title, summary, image, imageAlt, price, duration, audience, includes } = program.data;

const facts = [
  duration && { label: 'Duration', value: duration },
  price && { label: 'Cost', value: price },
  audience && { label: 'Who it suits', value: audience },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout title={title} description={summary} image={image}>
  <article>
    <header class="section head">
      <div class="shell shell--narrow">
        <p class="eyebrow"><a href="/programs">Programs</a></p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
    </header>

    {image && (
      <div class="shell">
        <img class="head__image" src={image} alt={imageAlt ?? ''} fetchpriority="high" />
      </div>
    )}

    <div class="shell body">
      <div class="prose">
        <Content />
      </div>

      <aside class="aside">
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map((fact) => (
              <div class="facts__row">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {includes.length > 0 && (
          <div class="includes">
            <h2>What's included</h2>
            <ul>{includes.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}

        <div class="aside__cta">
          <p>Interested in this program?</p>
          <a class="btn btn--primary" href="/contact">Make an enquiry</a>
          <p class="aside__alt">
            Or call <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
          </p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .head { padding-bottom: 2rem; }
  .head .eyebrow a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }

  .head__image {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block: var(--step);
  }

  @media (max-width: 54rem) {
    .body { grid-template-columns: 1fr; }
  }

  .aside {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 2rem;
    padding: 1.75rem;
    background: var(--paper-warm);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 54rem) {
    .aside { position: static; }
  }

  .facts { margin: 0; display: grid; gap: 1rem; }
  .facts__row { display: grid; gap: 0.2rem; }
  .facts dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .facts dd { margin: 0; font-size: 0.9375rem; }

  .includes h2 {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 0.75rem;
  }
  .includes ul { margin: 0; padding-left: 1.1rem; font-size: 0.9375rem; }
  .includes li + li { margin-top: 0.4rem; }

  .aside__cta { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .aside__cta > p:first-child { font-size: 0.9375rem; margin-bottom: 0.9rem; }
  .aside__alt { font-size: 0.875rem; color: var(--ink-soft); margin: 1rem 0 0; }
</style>
