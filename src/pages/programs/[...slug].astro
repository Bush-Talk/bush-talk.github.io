---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartImage from '../../components/SmartImage.astro';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const programs = (await getCollection('programs', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return programs.map((program) => ({
    params: { slug: program.id },
    props: {
      program,
      // Everything else, in order, wrapping around from this one.
      others: programs.filter((p) => p.id !== program.id),
    },
  }));
}) satisfies GetStaticPaths;

const { program, others } = Astro.props;
const { Content } = await render(program);
const { title, summary, image, imageAlt, price, duration, audience, includes } = program.data;

const facts = [
  duration && { label: 'Duration', value: duration },
  price && { label: 'Cost', value: price },
  audience && { label: 'Who it suits', value: audience },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout title={title} description={summary} image={image}>
  <article>
    <header class="section head">
      <div class="shell shell--narrow">
        <p class="eyebrow"><a href="/programs">Programs</a></p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
    </header>

    {image && (
      <div class="shell">
        <SmartImage
          class="head__image"
          src={image}
          alt={imageAlt ?? ''}
          widths={[640, 1024, 1400, 1800]}
          sizes="(max-width: 70rem) 100vw, 1120px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    <div class="shell body">
      <div class="prose">
        <Content />
      </div>

      <aside class="aside">
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map((fact) => (
              <div class="facts__row">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {includes.length > 0 && (
          <div class="includes">
            <h2>What's included</h2>
            <ul>{includes.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}

        <div class="aside__cta">
          <p>Interested in this program?</p>
          <a class="btn btn--primary" href="/contact">Make an enquiry</a>
          {site.phone && (
            <p class="aside__alt">
              Or call <a href={`tel:${site.phoneHref || site.phone}`}>{site.phone}</a>
            </p>
          )}
        </div>
      </aside>
    </div>

    {others.length > 0 && (
      <section class="section section--warm more">
        <div class="shell">
          <h2>Other programs</h2>
          <ul class="more__list">
            {others.map((other) => (
              <li>
                <a href={`/programs/${other.id}`}>
                  <span class="more__title">{other.data.title}</span>
                  <span class="more__summary">{other.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .head { padding-bottom: 2rem; }
  .head .eyebrow a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }

  :global(.head__image) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block: var(--step);
  }

  @media (max-width: 54rem) {
    .body { grid-template-columns: 1fr; }
  }

  .aside {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 2rem;
    padding: 1.75rem;
    background: var(--paper-warm);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 54rem) {
    .aside { position: static; }
  }

  .facts { margin: 0; display: grid; gap: 1rem; }
  .facts__row { display: grid; gap: 0.2rem; }
  .facts dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .facts dd { margin: 0; font-size: 0.9375rem; }

  .includes h2 {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 0.75rem;
  }
  .includes ul { margin: 0; padding-left: 1.1rem; font-size: 0.9375rem; }
  .includes li + li { margin-top: 0.4rem; }

  .aside__cta { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .aside__cta > p:first-child { font-size: 0.9375rem; margin-bottom: 0.9rem; }
  .aside__alt { font-size: 0.875rem; color: var(--ink-soft); margin: 1rem 0 0; }

  .more__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .more__list a {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--line);
    height: 100%;
  }

  @media (min-width: 40rem) {
    .more__list li + li a { border-left: 1px solid var(--line); padding-left: 1.5rem; }
    .more__list li:not(:last-child) a { padding-right: 1.5rem; }
  }

  .more__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--bark);
  }
  .more__list a:hover .more__title { color: var(--clay-deep); }

  .more__summary { font-size: 0.875rem; color: var(--ink-soft); line-height: 1.5; }
</style>
