---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramCard from '../components/ProgramCard.astro';
import SmartImage from '../components/SmartImage.astro';
import Pillars from '../components/shared/Pillars';
import { toImg } from '../lib/images';
import Testimonials from '../components/Testimonials.astro';
import { home } from '../lib/site';

const programs = (await getCollection('programs', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const pillars = await Promise.all(
  home.pillars.map(async (pillar) => ({
    ...pillar,
    image: await toImg(
      pillar.image,
      pillar.imageAlt,
      [320, 480, 720],
      '(max-width: 52rem) 100vw, 340px',
    ),
  })),
);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__copy">
        {home.heroEyebrow && <p class="eyebrow">{home.heroEyebrow}</p>}
        <h1>{home.heroHeading}</h1>
        {home.heroSubheading && <p class="hero__sub">{home.heroSubheading}</p>}
        <p class="hero__text">{home.heroText}</p>
        <div class="btn-row">
          {home.primaryCta.label && (
            <a class="btn btn--flame" href={home.primaryCta.href || '/contact'}>
              {home.primaryCta.label}
            </a>
          )}
          {home.secondaryCta?.label && (
            <a class="btn btn--secondary" href={home.secondaryCta.href || '/'}>
              {home.secondaryCta.label}
            </a>
          )}
        </div>
      </div>

      <div class="hero__media">
        <SmartImage
          src={home.heroImage}
          alt={home.heroImageAlt}
          widths={[480, 768, 1024, 1400]}
          sizes="(max-width: 52rem) 100vw, 46rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2>{home.pillarsHeading}</h2>
      {home.pillarsIntro && <p class="lede">{home.pillarsIntro}</p>}

      <Pillars pillars={pillars} />
    </div>
  </section>

  {programs.length > 0 && (
    <section class="section section--warm">
      <div class="shell">
        <h2>{home.programsHeading}</h2>
        {home.programsIntro && <p class="lede">{home.programsIntro}</p>}

        <div class="grid">
          {programs.map((program) => (
            <ProgramCard
              href={`/programs/${program.id}`}
              title={program.data.title}
              summary={program.data.summary}
              image={program.data.image}
              imageAlt={program.data.imageAlt}
              price={program.data.price}
              duration={program.data.duration}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section feature">
    <div class="shell feature__inner">
      <div class="feature__media">
        <SmartImage
          src={home.featureImage}
          alt={home.featureImageAlt}
          widths={[400, 640, 900]}
          sizes="(max-width: 52rem) 100vw, 420px"
          aspect="1"
        />
      </div>
      <div class="feature__copy">
        <p class="eyebrow">Weaving Workshops</p>
        <h2>{home.featureHeading}</h2>
        <p>{home.featureText}</p>
        {home.featureCta.label && (
          <div class="btn-row">
            <a class="btn btn--secondary" href={home.featureCta.href || '/weaving-workshops'}>
              {home.featureCta.label}
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <Testimonials heading="Reviews" featuredOnly showLink />

  <section class="section section--bark">
    <div class="shell shell--narrow closing">
      <h2>{home.closingHeading}</h2>
      <p class="lede">{home.closingText}</p>
      {home.closingCta.label && (
        <div class="btn-row">
          <a class="btn btn--primary" href={home.closingCta.href || '/contact'}>
            {home.closingCta.label}
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem); }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 52rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__media { order: -1; }
  }

  .hero__copy h1 { margin-bottom: 0.35em; }

  .hero__sub {
    font-family: var(--font-body);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.2rem, 1.08rem + 0.6vw, 1.45rem);
    line-height: 1.45;
    color: var(--sage-deep);
    margin-bottom: 1.1em;
  }

  .hero__text { color: var(--ink-soft); }

  /* Arched top, echoing the doorway shape on the current site. */
  .hero__media :global(img),
  .hero__media :global(.placeholder) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-arch);
  }

  @media (max-width: 52rem) {
    .hero__media :global(img),
    .hero__media :global(.placeholder) {
      aspect-ratio: 5 / 4;
      border-radius: 40% 40% 20px 20px / 22% 22% 20px 20px;
    }
  }

  .hero__placeholder {
    background:
      radial-gradient(circle at 25% 25%, color-mix(in srgb, var(--sage) 45%, transparent), transparent 55%),
      radial-gradient(circle at 80% 65%, color-mix(in srgb, var(--ochre) 40%, transparent), transparent 50%),
      var(--paper-deep);
  }


  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .feature__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 52rem) {
    .feature__inner { grid-template-columns: 1fr; }
  }

  .feature__media :global(img),
  .feature__media :global(.placeholder) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-arch);
  }

  @media (max-width: 52rem) {
    .feature__media :global(img),
    .feature__media :global(.placeholder) { aspect-ratio: 16 / 9; }
  }

  .closing { text-align: center; }
  .closing p { margin-inline: auto; }
  .closing .btn-row { justify-content: center; }
</style>
