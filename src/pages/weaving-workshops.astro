---
import { getCollection, render } from 'astro:content';
import ContactCta from '../components/ContactCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import WorkshopCard from '../components/shared/WorkshopCard';
import { toImg } from '../lib/images';
import { weaving, site } from '../lib/site';

const all = (await getCollection('workshops', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// A dated workshop drops off once it has passed; undated ones (group bookings,
// individual sessions) always show. Saves having to delete old entries.
const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = all.filter((w) => !w.data.date || w.data.date >= today);
const dated = upcoming.filter((w) => w.data.date);
const ongoing = upcoming.filter((w) => !w.data.date);

const rendered = await Promise.all(
  upcoming.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    img: await toImg(
      entry.data.image,
      entry.data.imageAlt ?? '',
      [320, 480, 640],
      '(max-width: 52rem) 100vw, 340px',
    ),
  })),
);
const contentFor = (id: string) => rendered.find((r) => r.entry.id === id)?.Content;
const imgFor = (id: string) => rendered.find((r) => r.entry.id === id)?.img;
---

<BaseLayout
  title="Weaving Workshops"
  description={weaving.intro}
>
  <section class="section">
    <div class="shell shell--narrow">
      <p class="eyebrow">{weaving.eyebrow}</p>
      <h1>{weaving.heading}</h1>
      <p class="lede">{weaving.intro}</p>
      {weaving.pullQuote && <p class="pull">&ldquo;{weaving.pullQuote}&rdquo;</p>}
    </div>
  </section>

  {dated.length > 0 && (
    <section class="section section--warm">
      <div class="shell">
        <h2>Upcoming weaving workshops</h2>
        <div class="grid">
          {dated.map(({ id, data }) => {
            const Content = contentFor(id);
            const when = [[data.dateLabel, data.time].filter(Boolean).join(' '), data.location]
              .filter(Boolean)
              .join('. ');
            return (
              <WorkshopCard
                title={data.title}
                when={when}
                image={imgFor(id)}
                price={data.price}
                duration={data.duration}
                ctaLabel={data.bookingUrl ? 'Book now' : 'Enquire'}
                ctaHref={data.bookingUrl ?? '/contact'}
              >
                {Content && <Content />}
              </WorkshopCard>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {ongoing.length > 0 && (
    <section class="section">
      <div class="shell">
        <h2>Always available</h2>
        <div class="grid">
          {ongoing.map(({ id, data }) => {
            const Content = contentFor(id);
            return (
              <WorkshopCard
                title={data.title}
                image={imgFor(id)}
                price={data.price}
                duration={data.duration}
                ctaHref="/contact"
              >
                {Content && <Content />}
              </WorkshopCard>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <Gallery group="weaving" heading="From the workshops" />

  {upcoming.length === 0 && (
    <section class="section">
      <div class="shell shell--narrow">
        <p class="lede">
          No workshops scheduled right now. Get in touch at
          <a href={`mailto:${site.email}`}>{site.email}</a> and we'll let you know when the
          next one is announced.
        </p>
      </div>
    </section>
  )}

  <ContactCta topic="Weaving workshop" heading="Enquire about a workshop" />
</BaseLayout>

<style>
  .pull {
    margin-top: 2.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
    font-style: italic;
    color: var(--clay-deep);
    line-height: 1.35;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }


</style>
