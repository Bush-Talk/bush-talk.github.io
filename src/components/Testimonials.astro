---
import { getCollection } from 'astro:content';
import Quote from './shared/Quote';

interface Props {
  heading?: string;
  /** Only show entries ticked as featured. */
  featuredOnly?: boolean;
  limit?: number;
  showLink?: boolean;
}

const { heading = 'Reviews', featuredOnly = false, limit, showLink = false } = Astro.props;

const all = (
  await getCollection('testimonials', ({ data }) => !data.draft && (!featuredOnly || data.featured))
).sort((a, b) => a.data.order - b.data.order);

const items = limit ? all.slice(0, limit) : all;
---

{items.length > 0 && (
  <section class="section section--warm">
    <div class="shell">
      <h2>{heading}</h2>
      <div class="quotes">
        {items.map(({ data }) => (
          <Quote quote={data.quote} author={data.author} role={data.role} />
        ))}
      </div>

      {showLink && (
        <div class="btn-row">
          <a class="btn btn--secondary" href="/reviews">Read more reviews</a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    margin-top: 2.5rem;
  }
</style>
