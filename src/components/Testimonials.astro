---
import { getCollection } from 'astro:content';

interface Props {
  heading?: string;
  /** Only show entries ticked as featured. */
  featuredOnly?: boolean;
  limit?: number;
  showLink?: boolean;
}

const { heading = 'Reviews', featuredOnly = false, limit, showLink = false } = Astro.props;

const all = (
  await getCollection('testimonials', ({ data }) => !data.draft && (!featuredOnly || data.featured))
).sort((a, b) => a.data.order - b.data.order);

const items = limit ? all.slice(0, limit) : all;
---

{items.length > 0 && (
  <section class="section section--warm">
    <div class="shell">
      <h2>{heading}</h2>
      <div class="quotes">
        {items.map(({ data }) => (
          <figure class="quote">
            <blockquote>{data.quote}</blockquote>
            <figcaption>
              <span class="quote__author">{data.author}</span>
              {data.role && <span class="quote__role">{data.role}</span>}
            </figcaption>
          </figure>
        ))}
      </div>

      {showLink && (
        <div class="btn-row">
          <a class="btn btn--secondary" href="/reviews">Read more reviews</a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .quote { margin: 0; }

  .quote blockquote {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
    border-left: 3px solid var(--ochre);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.2rem);
    line-height: 1.5;
    color: var(--ink);
  }

  .quote figcaption { padding-left: calc(1.4rem + 3px); }
  .quote__author { display: block; font-weight: 500; font-size: 0.9375rem; }
  .quote__role { display: block; font-size: 0.875rem; color: var(--ink-faint); margin-top: 0.15rem; }
</style>
