---
import ProgramCard from './shared/ProgramCard';
import { toImg } from '../lib/images';

interface Props {
  href: string;
  title: string;
  summary: string;
  image?: string;
  imageAlt?: string;
  price?: string;
  duration?: string;
}

const { href, title, summary, image, imageAlt, price, duration } = Astro.props;

// Thin wrapper: resolve the image here, then hand plain data to the component
// that the CMS preview also renders.
const img = await toImg(image, imageAlt ?? '', [320, 480, 640], '(max-width: 52rem) 100vw, 360px');
---

<ProgramCard href={href} title={title} summary={summary} image={img} price={price} duration={duration} />
