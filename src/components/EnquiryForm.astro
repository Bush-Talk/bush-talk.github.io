---
import { site } from '../lib/site';

/**
 * Posts straight to HubSpot's unauthenticated Forms v3 endpoint. That endpoint
 * supports CORS and needs no credentials, which is what keeps this site fully
 * static — there is no server here and no secret in the bundle.
 *
 * Set these in .env (see .env.example):
 *   PUBLIC_HUBSPOT_PORTAL_ID
 *   PUBLIC_HUBSPOT_FORM_GUID
 *
 * Two variants:
 *   full     — the contact page. Everything HubSpot can usefully capture.
 *   minimal  — the bottom of every other page. Name, email, message.
 *
 * Both post identically, so there's one script and one place to change it.
 * Field ids are namespaced per instance because a page can hold more than one.
 */

interface Props {
  variant?: 'full' | 'minimal';
  /** Preselects the service, e.g. on the weaving page. */
  topic?: string;
}

const { variant = 'full', topic } = Astro.props;
const full = variant === 'full';

const portalId = import.meta.env.PUBLIC_HUBSPOT_PORTAL_ID ?? '';
const formGuid = import.meta.env.PUBLIC_HUBSPOT_FORM_GUID ?? '';
const configured = Boolean(portalId && formGuid);

// Mirrors the "Choose Your Service" options on the current site.
const enquiryTypes = [
  'Bush Kinder',
  'Small group sessions',
  'Whole school well-being program',
  'Family sessions',
  'Individual sessions',
  'Weaving workshop',
];

// Unique per instance so labels bind to the right input when two forms coexist.
const uid = `enq-${Math.random().toString(36).slice(2, 8)}`;
const id = (name: string) => `${uid}-${name}`;
---

<form
  class:list={['enquiry', !full && 'enquiry--minimal']}
  data-enquiry
  data-portal-id={portalId}
  data-form-guid={formGuid}
  novalidate
>
  {full ? (
    <div class="enquiry__grid">
      <p class="field">
        <label for={id('firstname')}>First name <span aria-hidden="true">*</span></label>
        <input type="text" id={id('firstname')} name="firstname" autocomplete="given-name" required />
      </p>
      <p class="field">
        <label for={id('lastname')}>Last name <span aria-hidden="true">*</span></label>
        <input type="text" id={id('lastname')} name="lastname" autocomplete="family-name" required />
      </p>
      <p class="field">
        <label for={id('email')}>Email <span aria-hidden="true">*</span></label>
        <input type="email" id={id('email')} name="email" autocomplete="email" required />
      </p>
      <p class="field">
        <label for={id('phone')}>Phone <span class="field__hint">optional</span></label>
        <input type="tel" id={id('phone')} name="phone" autocomplete="tel" />
      </p>
      <p class="field">
        <label for={id('company')}>Organisation <span class="field__hint">optional</span></label>
        <input type="text" id={id('company')} name="company" autocomplete="organization" />
      </p>
      <p class="field">
        <label for={id('preferred_date')}>Preferred date <span class="field__hint">optional</span></label>
        <input type="date" id={id('preferred_date')} name="preferred_date" />
      </p>
    </div>
  ) : (
    <div class="enquiry__grid">
      <p class="field">
        <label for={id('name')}>Your name <span aria-hidden="true">*</span></label>
        <input type="text" id={id('name')} name="name" autocomplete="name" required />
      </p>
      <p class="field">
        <label for={id('email')}>Email <span aria-hidden="true">*</span></label>
        <input type="email" id={id('email')} name="email" autocomplete="email" required />
      </p>
    </div>
  )}

  {full && (
    <p class="field">
      <label for={id('enquiry_type')}>Choose your service</label>
      <select id={id('enquiry_type')} name="enquiry_type">
        <option value="">Choose one…</option>
        {enquiryTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
    </p>
  )}

  {/* On a topic-specific page the service is already known. */}
  {!full && topic && <input type="hidden" name="enquiry_type" value={topic} />}

  <p class="field">
    <label for={id('message')}>
      {full ? 'How can we help you?' : 'What would you like to know?'} <span aria-hidden="true">*</span>
    </label>
    <textarea id={id('message')} name="message" rows={full ? 6 : 4} required></textarea>
  </p>

  <p class="field field--check">
    <input type="checkbox" id={id('consent')} name="consent" required />
    <label for={id('consent')}>
      I'm happy for {site.name} to store these details and get back to me about my enquiry.
    </label>
  </p>

  {/* Honeypot. Real people never fill this in; bots usually do. */}
  <p class="enquiry__trap" aria-hidden="true">
    <label for={id('company_website')}>Leave this field empty</label>
    <input type="text" id={id('company_website')} name="company_website" tabindex="-1" autocomplete="off" />
  </p>

  <div class="btn-row">
    <button class="btn btn--flame" type="submit" data-submit>Send enquiry</button>
  </div>

  <p class="enquiry__status" data-status role="status" aria-live="polite"></p>

  {!configured && (
    <p class="enquiry__warn">
      <strong>Not wired up yet.</strong> Add <code>PUBLIC_HUBSPOT_PORTAL_ID</code> and
      <code>PUBLIC_HUBSPOT_FORM_GUID</code> to <code>.env</code>. Until then this form
      won't send{site.email && <> — people can still reach us at <a href={`mailto:${site.email}`}>{site.email}</a></>}.
    </p>
  )}
</form>

<noscript>
  <p>
    This form needs JavaScript. You can reach us
    {site.email && <> by email at <a href={`mailto:${site.email}`}>{site.email}</a></>}
    {site.phone && <> or on {site.phone}</>}.
  </p>
</noscript>

<style>
  .enquiry { max-width: 640px; }
  .enquiry--minimal { max-width: 34rem; }

  .enquiry__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0 1.25rem;
  }

  .field { margin: 0 0 1.25rem; max-width: none; }

  .field label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .field__hint { color: var(--ink-faint); font-weight: 400; }

  .field input[type='text'],
  .field input[type='email'],
  .field input[type='tel'],
  .field input[type='date'],
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 140ms ease;
  }

  .field input[type='date'] { min-height: 2.9rem; }
  .field textarea { resize: vertical; min-height: 6rem; }

  .field input:hover,
  .field select:hover,
  .field textarea:hover { border-color: var(--ink-faint); }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible { border-color: var(--clay-deep); }

  .field [aria-invalid='true'] { border-color: var(--clay-darker); }

  .field--check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
  }
  .field--check input { margin-top: 0.3rem; width: 1rem; height: 1rem; accent-color: var(--sage-deep); }
  .field--check label { font-weight: 400; font-size: 0.9375rem; margin: 0; }

  .enquiry__error {
    display: block;
    font-size: 0.8125rem;
    color: var(--clay-darker);
    margin-top: 0.35rem;
  }

  /* Off-screen rather than display:none — some bots skip hidden fields. */
  .enquiry__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .enquiry__status:empty { display: none; }
  .enquiry__status {
    margin-top: 1.25rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    font-size: 0.9375rem;
  }
  .enquiry__status[data-state='ok'] { background: var(--sage-pale); color: var(--bark-deep); }
  .enquiry__status[data-state='error'] { background: var(--clay-pale); color: var(--clay-darker); }

  .enquiry__warn {
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    background: var(--sand);
    border-left: 3px solid var(--clay);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }
  .enquiry__warn code { font-size: 0.8125rem; background: rgba(0, 0, 0, 0.06); padding: 0.1em 0.35em; border-radius: 3px; }

  .btn-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
</style>

<script>
  /** HubSpot ties a submission to its analytics session via this cookie. */
  const readHutk = () =>
    document.cookie.split('; ').find((c) => c.startsWith('hubspotutk='))?.split('=')[1];

  /** A single "Your name" field still wants to land as first/last in the CRM. */
  const splitName = (value: string) => {
    const parts = value.trim().split(/\s+/);
    if (parts.length < 2) return { firstname: parts[0] ?? '', lastname: '' };
    return { firstname: parts.slice(0, -1).join(' '), lastname: parts.at(-1)! };
  };

  // Several forms can share a page, so wire each one rather than a single id.
  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const { portalId, formGuid } = form.dataset;

    const setStatus = (message: string, state: 'ok' | 'error') => {
      status.textContent = message;
      status.dataset.state = state;
    };

    const clearErrors = () => {
      form.querySelectorAll('.enquiry__error').forEach((el) => el.remove());
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    };

    /** Native validity, surfaced inline so errors sit next to the field. */
    const validate = () => {
      clearErrors();
      const invalid = [...form.elements].filter(
        (el): el is HTMLInputElement | HTMLTextAreaElement =>
          (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) &&
          el.name !== 'company_website' &&
          !el.checkValidity(),
      );

      for (const field of invalid) {
        field.setAttribute('aria-invalid', 'true');
        const note = document.createElement('span');
        note.className = 'enquiry__error';
        note.textContent = field.validationMessage;
        field.closest('.field')?.append(note);
      }

      invalid[0]?.focus();
      return invalid.length === 0;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate()) return;

      // Honeypot tripped — pretend it worked rather than telling the bot.
      if ((form.elements.namedItem('company_website') as HTMLInputElement)?.value) {
        setStatus('Thanks — we will be in touch shortly.', 'ok');
        form.reset();
        return;
      }

      if (!portalId || !formGuid) {
        setStatus('This form is not connected yet. Please email us instead.', 'error');
        return;
      }

      const data = new FormData(form);
      const raw: Record<string, string> = {};
      for (const key of ['firstname', 'lastname', 'email', 'phone', 'company', 'enquiry_type', 'preferred_date', 'message']) {
        raw[key] = String(data.get(key) ?? '').trim();
      }
      const name = String(data.get('name') ?? '').trim();
      if (name) Object.assign(raw, splitName(name));

      const fields = Object.entries(raw)
        .filter(([, value]) => value !== '')
        .map(([name, value]) => ({ name, value }));

      submit.disabled = true;
      const original = submit.textContent;
      submit.textContent = 'Sending…';

      try {
        const hutk = readHutk();
        const response = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formGuid}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              fields,
              context: {
                pageUri: window.location.href,
                pageName: document.title,
                ...(hutk ? { hutk } : {}),
              },
              legalConsentOptions: {
                consent: {
                  consentToProcess: true,
                  text: 'I agree to Bush Talk storing my details to respond to this enquiry.',
                },
              },
            }),
          },
        );

        if (!response.ok) throw new Error(`HubSpot responded ${response.status}`);

        setStatus('Thanks — your enquiry is on its way. We usually reply within a couple of days.', 'ok');
        form.reset();
      } catch (error) {
        console.error(error);
        setStatus('Something went wrong sending that. Please email us directly and we will pick it up.', 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = original;
      }
    });
  });
</script>
