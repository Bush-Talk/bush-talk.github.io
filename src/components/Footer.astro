---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__tag">{site.footerTagline}</p>
    </div>

    <div class="site-footer__group">
      <h2>Get in touch</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li class="site-footer__muted">{site.hours}</li>
      </ul>
    </div>

    <div class="site-footer__group">
      <h2>Where we work</h2>
      <ul>
        {site.locations.map((place) => <li class="site-footer__muted">{place}</li>)}
      </ul>
    </div>

    {site.social.length > 0 && (
      <div class="site-footer__group">
        <h2>Follow along</h2>
        <ul>
          {site.social.map((item) => (
            <li><a href={item.url} rel="me noopener">{item.label}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="shell site-footer__base">
    <p class="site-footer__acknowledgement">{site.acknowledgement}</p>
    <p class="site-footer__copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--step);
    background: var(--bark);
    color: var(--sage-pale);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2.5rem;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--paper);
    margin: 0 0 0.4rem;
  }
  .site-footer__tag { color: var(--ochre); font-size: 0.9375rem; margin: 0; max-width: 24ch; }

  .site-footer__group h2 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ochre);
    margin: 0 0 1rem;
  }

  .site-footer__group ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__group li + li { margin-top: 0.5rem; }
  .site-footer__group a { color: var(--paper); text-decoration: none; border-bottom: 1px solid rgba(251, 247, 240, 0.25); }
  .site-footer__group a:hover { color: var(--ochre); border-bottom-color: var(--ochre); }
  .site-footer__muted { color: var(--sage-pale); opacity: 0.75; font-size: 0.9375rem; }

  .site-footer__base {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid rgba(251, 247, 240, 0.15);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-footer__acknowledgement {
    max-width: 62ch;
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.8;
    margin: 0;
  }

  .site-footer__copy { font-size: 0.875rem; opacity: 0.6; margin: 0; }
</style>
