---
import EnquiryForm from './EnquiryForm.astro';
import { site } from '../lib/site';

/**
 * The enquiry block that closes most pages. Bek asked for a form at the bottom
 * of every page except About — a link to the contact page loses people, a form
 * in front of them doesn't.
 *
 * Deliberately the minimal variant: name, email, message. The full field set
 * lives on /contact for people who arrive ready to book.
 */

interface Props {
  heading?: string;
  text?: string;
  /** Preselects the service when the page is about one. */
  topic?: string;
}

const {
  heading = 'Make an enquiry',
  text = 'Every program is shaped around the people in it. Tell us who you work with and what you are hoping for.',
  topic,
} = Astro.props;
---

<section class="section contact-cta section--warm">
  <div class="shell contact-cta__inner">
    <div class="contact-cta__copy">
      <h2>{heading}</h2>
      <p class="lede">{text}</p>

      <ul class="contact-cta__direct">
        {site.email && (
          <li>
            <span>Email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        )}
        {site.phone && (
          <li>
            <span>Phone</span>
            <a href={`tel:${site.phoneHref || site.phone}`}>{site.phone}</a>
          </li>
        )}
        {site.hours && (
          <li>
            <span>Hours</span>
            <span class="contact-cta__muted">{site.hours}</span>
          </li>
        )}
      </ul>
    </div>

    <div class="contact-cta__form">
      <EnquiryForm variant="minimal" topic={topic} />
    </div>
  </div>
</section>

<style>
  .contact-cta__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 54rem) {
    .contact-cta__inner { grid-template-columns: 1fr; }
  }

  .contact-cta__copy h2 { margin-bottom: 0.3em; }

  .contact-cta__direct {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .contact-cta__direct li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.9375rem;
  }

  .contact-cta__direct li > span:first-child {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay-darker);
  }

  .contact-cta__muted { color: var(--ink-soft); }
</style>
