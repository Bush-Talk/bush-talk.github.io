---
import { site } from '../lib/site';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Talk to us about your group',
  text = 'Every program is shaped around the people in it. Tell us who you work with and what you are hoping for.',
} = Astro.props;
---

<section class="section contact-cta section--warm">
  <div class="shell contact-cta__inner">
    <div class="contact-cta__copy">
      <h2>{heading}</h2>
      <p class="lede">{text}</p>
    </div>

    <div class="contact-cta__actions">
      <a class="btn btn--flame" href="/contact">Make an enquiry</a>

      <ul class="contact-cta__direct">
        {site.email && (
          <li>
            <span>Email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        )}
        {site.phone && (
          <li>
            <span>Phone</span>
            <a href={`tel:${site.phoneHref || site.phone}`}>{site.phone}</a>
          </li>
        )}
        {site.hours && (
          <li>
            <span>Hours</span>
            <span class="contact-cta__muted">{site.hours}</span>
          </li>
        )}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-cta__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 52rem) {
    .contact-cta__inner { grid-template-columns: 1fr; }
  }

  .contact-cta__copy h2 { margin-bottom: 0.4em; }
  .contact-cta__copy p { margin-bottom: 0; }

  .contact-cta__actions { display: grid; gap: 1.75rem; justify-items: start; }

  .contact-cta__direct {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    width: 100%;
  }

  .contact-cta__direct li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.9375rem;
  }

  .contact-cta__direct li > span:first-child {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .contact-cta__muted { color: var(--ink-soft); }

</style>
