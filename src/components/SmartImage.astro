---
import { Image } from 'astro:assets';
import { resolveImage, isExternal } from '../lib/images';

interface Props {
  src?: string;
  alt?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto' | 'low';
  class?: string;
  aspect?: string;
}

const {
  src,
  alt = '',
  widths = [400, 800, 1200, 1600],
  sizes = '(max-width: 52rem) 100vw, 50vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
  aspect,
} = Astro.props;

const resolved = resolveImage(src);
const style = aspect ? `aspect-ratio:${aspect}` : undefined;

// Only local images go through the optimiser; external URLs and unresolved
// paths fall back to a plain tag so a bad CMS path degrades rather than breaks.
---

{
  resolved ? (
    <Image
      src={resolved}
      alt={alt}
      widths={widths.filter((w) => w <= resolved.width)}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
      style={style}
    />
  ) : src ? (
    <img
      src={src}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
      style={style}
      data-external={isExternal(src) ? '' : undefined}
    />
  ) : (
    <div class={`placeholder ${className ?? ''}`} style={style} aria-hidden="true" />
  )
}

<style>
  .placeholder {
    width: 100%;
    background:
      radial-gradient(circle at 25% 25%, color-mix(in srgb, var(--sage) 45%, transparent), transparent 55%),
      radial-gradient(circle at 80% 65%, color-mix(in srgb, var(--ochre) 40%, transparent), transparent 50%),
      var(--paper-deep);
    border-radius: var(--radius-lg);
  }
</style>
